    "@gltf-transform/functions": "4.5.1",
    "draco3dgltf": "1.5.7",
    "esbuild": "0.28.2",
    "free-tex-packer-core": "0.3.9",
    "meshoptimizer": "1.3.0",
    "pixelmatch": "7.2.0",
    "pixi.js": "8.21.0",
    "pngjs": "7.0.0",
    "sharp": "0.35.5",
    "three": "0.186.1"
  },
  "optionalDependencies": {
