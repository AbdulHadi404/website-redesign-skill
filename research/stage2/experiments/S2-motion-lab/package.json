{
  "name": "s2-motion-lab",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "S2 motion lab: seven interactions × eight tools (interruption, reduced motion, main thread, rAF at rest, size); Rive vs Lottie vs dotLottie vs SVG/CSS vs sprite for one stateful toggle and a loop; scripts/motion.mjs scored on four fixture builds, the six Part A pages (guarded and not), dev pages before/after, 15 held-out pages (frozen version and current), and a starved-page stress test.",
  "license": "MIT",
  "scripts": {
    "fetch": "node fetch-assets.mjs && node c/fetch-ext.mjs",
    "all": "node run.mjs",
    "a": "node run.mjs --only a",
    "b": "node run.mjs --only b",
    "c": "node run.mjs --only c",
    "x": "node run.mjs --only x",
    "rescore": "node run.mjs --only c --rescore",
    "pages": "node c/run-pages.mjs --before --frozen",
    "verify-hover": "node c/verify-hover.mjs --set heldout",
    "summary": "node summarize.mjs"
  },
  "dependencies": {
    "@formkit/auto-animate": "0.10.0",
    "@lottiefiles/dotlottie-web": "0.80.0",
    "@react-spring/web": "10.1.2",
    "@rive-app/canvas": "2.43.1",
    "@rive-app/canvas-lite": "2.43.1",
    "@rive-app/react-canvas": "4.35.0",
    "@rive-app/webgl2": "2.43.1",
    "@theatre/core": "0.7.2",
    "animejs": "4.5.0",
    "esbuild": "0.28.2",
    "gsap": "3.15.0",
    "lottie-web": "5.13.0",
    "motion": "13.4.4",
    "pngjs": "^7.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  }
}
